APP_NAME="Laravel Testing"
APP_ENV=testing
APP_KEY=base64:u/nE+0v2t5v0N2R3b4V5w6X7y8Z9a0b1c2d3e4f5g6h=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Hashing speed optimization for tests (default: 12)
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Opsi 1: Fast In-Memory SQLite (Rekomendasi default untuk Unit & Feature Test cepat)
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_FOREIGN_KEYS=true

# Opsi 2: Dedicated MySQL Test Database (Untuk testing yang membutuhkan MySQL feature parity)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sample_template_cms_vue_test
# DB_USERNAME=root
# DB_PASSWORD=
# -----------------------------------------------------------------------------

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

MAIL_MAILER=array
MAIL_FROM_ADDRESS="test@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
